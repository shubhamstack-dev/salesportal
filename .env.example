# Copy to .env and change every value before going live.
MYSQL_USER=sales
MYSQL_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_HOURS=10
APP_TZ=Asia/Kolkata
APP_PORT=8080
# On the server: APP_PORT=127.0.0.1:8083 (reachable only through Caddy)
CORS_ORIGINS=http://localhost:8080
# On the server: CORS_ORIGINS=https://salesportal.nexdaequmsupport.com
